# altare-grabber 配置示例
#
# 复制到 /etc/altr.env 并 chmod 600，不要提交到仓库。
# 全部留空也能跑：脚本会静默运行，只写日志。

# ---- Telegram 通知（可选）----
# 找 @BotFather 建 bot 拿 token；chat id 可以问 @userinfobot
# 配好后记得先给你的 bot 发一条 /start，否则它不能主动发消息给你
TG_TOKEN=""
TG_CHAT=""

# ---- 团队池 ----
# 可用区域：altr server locations
# 可用模板：altr server templates
#LOCATIONS="sg-sgp kg-bsz th-bkk id-jkt mn-uln de-fra fi-hel se-kna us-lax us-iad au-bne in-mum"
#TEMPLATE="Ubuntu 24.04"
#MEM_CANDIDATES="4096 2048"
#CPU=100
#DISK=5120

# ★ 重要：填你自己账号的真实免费额度上限。
# 脚本用「上限 − 现有机器占用」算剩余可抢量。
# 填小了会提前误判"配额不足"退出，填大了会发出注定失败的请求。
# 默认值只是示例。
#QUOTA_MEM=6144
#QUOTA_DISK=10240

# ---- 节奏 ----
#DELAY=60
#JITTER=25
#DELAY_429=240
#DELAY_BUSY=120
#QUOTA_EVERY=10

# ---- Go 池 ----
#TTL="12h"
#IMAGE="ubuntu"
